# ==========================================
# Creating a List
# ==========================================

# A list can store multiple data types

lists = [
    1,
    "Sumit",
    3 + 3j,
    True,
    1.23,
    234,
    332
]

print("Original List :")

print(lists)

# OUTPUT:
# [1, 'Sumit', (3+3j), True, 1.23, 234, 332]


# ==========================================
# List is Mutable
# ==========================================

print("\n===== List Mutability =====")

# Replace last element

lists[-1] = "abc"

print("After First Update :")

print(lists)

# Replace again

lists[-1] = 23222

print("After Second Update :")

print(lists)

# OUTPUT:
# [1, 'Sumit', (3+3j), True, 1.23, 234, 23222]


# ==========================================
# Iterating Through List
# ==========================================

print("\n===== Iterating Through List =====")

for item in lists:

    print(item)

# OUTPUT:
# 1
# Sumit
# (3+3j)
# True
# 1.23
# 234
# 23222


# ==========================================
# List Slicing Examples
# ==========================================

print("\n===== List Slicing Examples =====")

print("Original List :", lists)


# ------------------------------------------
# Slice from index 1 to end
# ------------------------------------------

sl1 = lists[1:]

print("\nSlicing [1:] :", sl1)

# OUTPUT:
# ['Sumit', (3+3j), True, 1.23, 234, 23222]


# ------------------------------------------
# Step size 2
# ------------------------------------------

sl2 = lists[::2]

print("Slicing [::2] :", sl2)

# OUTPUT:
# [1, (3+3j), 1.23, 23222]


# ------------------------------------------
# Step size 3
# ------------------------------------------

sl3 = lists[::3]

print("Slicing [::3] :", sl3)

# OUTPUT:
# [1, True, 23222]


# ------------------------------------------
# Start from index 1, step size 2
# ------------------------------------------

sl4 = lists[1::2]

print("Slicing [1::2] :", sl4)

# OUTPUT:
# ['Sumit', True, 234]


# ------------------------------------------
# Reverse slicing with step -2
# ------------------------------------------

sl5 = lists[1::-2]

print("Slicing [1::-2] :", sl5)

# OUTPUT:
# ['Sumit']


# ------------------------------------------
# Start from last element
# and move backwards by 2
# ------------------------------------------

sl6 = lists[-1::-2]

print("Slicing [-1::-2] :", sl6)

# OUTPUT:
# [23222, 1.23, (3+3j), 1]


# ------------------------------------------
# Start from last element
# and move backwards by 3
# ------------------------------------------

sl7 = lists[-1::-3]

print("Slicing [-1::-3] :", sl7)

# OUTPUT:
# [23222, True, 1]


# ------------------------------------------
# Reverse the complete list
# ------------------------------------------

sl8 = lists[::-1]

print("Slicing [::-1] :", sl8)

# OUTPUT:
# [23222, 234, 1.23, True, (3+3j), 'Sumit', 1]


# ------------------------------------------
# Reverse with step size 2
# ------------------------------------------

sl9 = lists[::-2]

print("Slicing [::-2] :", sl9)

# OUTPUT:
# [23222, 1.23, (3+3j), 1]


# ------------------------------------------
# Copy complete list
# ------------------------------------------

sl10 = lists[::1]

print("Slicing [::1] :", sl10)

# OUTPUT:
# [1, 'Sumit', (3+3j), True, 1.23, 234, 23222]


# ==========================================
# Original List Remains Unchanged
# ==========================================

print("\nOriginal List After Slicing :")

print(lists)

# OUTPUT:
# [1, 'Sumit', (3+3j), True, 1.23, 234, 23222]


