# ==========================================
# Looping with range()
# ==========================================

print("Numbers from 1 to 100")

for i in range(1, 101, 1):
    print(i)

# OUTPUT:
# 1 2 3 ... 100


print("\nNumbers from 0 to 100")

for i in range(101):
    print(i)

# OUTPUT:
# 0 1 2 3 ... 100


print("\nReverse counting from 50 to 0")

for i in range(50, -1, -1):
    print(i)

# OUTPUT:
# 50 49 48 ... 0


print("\nReverse counting from 500 to 0 with step -5")

for i in range(500, -1, -5):
    print(i)

# OUTPUT:
# 500 495 490 ... 0


# ==========================================
# Looping Through String
# ==========================================

print("\nIteration through String")

name = "Sumit Anil Shrivastav"

for character in name:
    print(character)

# OUTPUT:
# S
# u
# m
# i
# t
# ...


# ==========================================
# Looping Through List
# ==========================================

print("\nIteration through List")

lists = ["List", 1, 2, 12.33, True]

for item in lists:
    print(item)

# OUTPUT:
# List
# 1
# 2
# 12.33
# True


# ==========================================
# Looping Through Tuple
# ==========================================

print("\nIteration through Tuple")

tuples = (1, 22, 33, 44, 55, 55)

print("Tuple Data:", tuples)

for item in tuples:
    print(item)

# OUTPUT:
# 1
# 22
# 33
# 44
# 55
# 55


# ==========================================
# Looping Through Set
# ==========================================

print("\nIteration through Set")

sets = {1, 22, 33, 44, 44, 55, 55}

print("Set Data:", sets)

for item in sets:
    print(item)

# OUTPUT:
# Duplicate values are automatically removed
# because sets store only unique values.


# ==========================================
# Looping Through Dictionary
# ==========================================

print("\nIteration through Dictionary")

student_dict = {
    "Name": "Sumit",
    "Marks": 100,
    "Grade": "A+"
}

print(student_dict)

# Iterating dictionary using items()
for key, value in student_dict.items():

    print(f"{key} : {value}")

# OUTPUT:
# Name : Sumit
# Marks : 100
# Grade : A+
