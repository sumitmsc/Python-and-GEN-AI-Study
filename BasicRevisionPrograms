print("=" * 50)
print("PYTHON BASICS REVISION PROGRAM")
print("=" * 50)

# --------------------------------------------------
# LIST
# --------------------------------------------------
print("\n1. LIST EXAMPLE")

languages = ["Python", "Java", "C#", "JavaScript"]

print("Original List:", languages)

# Add element
languages.append("Go")
print("After append:", languages)

# Remove element
languages.remove("Java")
print("After remove:", languages)

# Loop through list
print("Languages:")
for language in languages:
    print(language)

# List Comprehension
lengths = [len(language) for language in languages]
print("Length of each language:", lengths)

# --------------------------------------------------
# TUPLE
# --------------------------------------------------
print("\n2. TUPLE EXAMPLE")

employee = ("Sumit", 101, "QA Engineer")

print("Employee Details:", employee)

print("Name:", employee[0])
print("Employee ID:", employee[1])
print("Designation:", employee[2])

# Count elements
print("Total Elements:", len(employee))

# --------------------------------------------------
# DICTIONARY
# --------------------------------------------------
print("\n3. DICTIONARY EXAMPLE")

student = {
    "name": "Amit",
    "age": 20,
    "course": "Computer Science"
}

print("Student Information:")

for key, value in student.items():
    print(f"{key} : {value}")

# Add new key-value pair
student["grade"] = "A"

print("\nUpdated Dictionary:")
for key, value in student.items():
    print(f"{key} : {value}")

# --------------------------------------------------
# SET
# --------------------------------------------------
print("\n4. SET EXAMPLE")

numbers = {10, 20, 30, 40, 20, 30}

print("Set:", numbers)

# Add element
numbers.add(50)
print("After adding 50:", numbers)

# Remove element
numbers.remove(20)
print("After removing 20:", numbers)

# Check membership
if 30 in numbers:
    print("30 is present in the set")

# --------------------------------------------------
# COMBINED EXAMPLE
# --------------------------------------------------
print("\n5. COMBINED EXAMPLE")

employees = [
    {"id": 1, "name": "Sumit"},
    {"id": 2, "name": "Amit"},
    {"id": 3, "name": "Rahul"}
]

print("Employee Names:")

for employee in employees:
    print(employee["name"])

# Unique employee names using set
unique_names = {employee["name"] for employee in employees}

print("Unique Names:", unique_names)

print("\nProgram Completed Successfully!")
