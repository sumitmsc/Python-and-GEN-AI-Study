# ==========================================
# Temperature Conversion Function
# ==========================================

def temperature_change(temp_value, unit):
    """
    Convert temperature between
    Celsius and Fahrenheit.

    Parameters:
    temp_value : Numeric temperature value
    unit       : 'C' for Celsius
                 'F' for Fahrenheit

    Returns:
    Converted temperature value
    """

    if unit.upper() == "C":

        # Celsius to Fahrenheit
        temperature = (temp_value * 9/5) + 32

        print(
            f"{temp_value}°C = "
            f"{temperature:.2f}°F"
        )

        return temperature

    elif unit.upper() == "F":

        # Fahrenheit to Celsius
        temperature = (temp_value - 32) * 5/9

        print(
            f"{temp_value}°F = "
            f"{temperature:.2f}°C"
        )

        return temperature

    else:

        print("Invalid Unit Entered!")
        return None


# ==========================================
# Function Calls
# ==========================================

temperature_change(25, "C")

temperature_change(77, "F")

temperature_change(100, "C")

temperature_change(32, "F")


