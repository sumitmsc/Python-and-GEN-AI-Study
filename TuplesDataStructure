---

# Python Program

```python
# Tuple Examples

tuple1 = (1, 2, 3, 4, 5)
print("Tuple 1:", tuple1)

tuple2 = (6, 7, 8, 9, 10)
print("Tuple 2:", tuple2)

# Concatenation of tuples

tup3 = tuple1 + tuple2
print("Combined Tuple:", tup3)

# Tuple Methods

tup1_data = tuple1.index(4)
print("Index of value 4 in tuple1:", tup1_data)

tup2_count = tuple1.count(4)
print("Count of value 4 in tuple1:", tup2_count)

# Packing of Tuples

a = 1, 2, 3, 4, 5, 6, 7
print("Packed Tuple:", a)

# Unpacking of Tuples

a, b, c, d, e, f, g, h = 1, 2, 3, 4, 5, 6, 7, 8

print("Unpacked Values:")
print(a)
print(b)
print(c)
print(d)
print(e)
print(f)
print(g)
print(h)

# Unpacking using *
a, *b, c = 1, 2, 3, 4, 5, 6, 7, 8

print("First Value:", a)
print("Middle Values:", b)
print("Last Value:", c)

# Nested List
Nested_list = [
    [1, 2, 3, "a", "b", "c", True],
    [4, 5, 6, "d", "e", "f", False],
    [7, 8, 9, "g", "h", "i", True]
]

print("Nested List:", Nested_list)
print("First List:", Nested_list[0])
print("Second List:", Nested_list[1])
print("Third List:", Nested_list[2])

# Accessing nested element
print("Boolean value from third list:", Nested_list[2][6])

# Nested Tuples inside a List
Nested_tuple_inList = [
    (1, 2, 3, 3, 3, "a", "b", "c", True),
    (4, 5, 6, "d", "e", "f", False),
    (7, 8, 9, "g", "h", "i", True)
]

print("Nested Tuples in List:", Nested_tuple_inList)
print(Nested_tuple_inList[0])
print(Nested_tuple_inList[1])
print(Nested_tuple_inList[2])

# Nested Tuples
Nested_tuples = (
    (1, 2, 3, 3, 3, "a", "b", "c", True),
    (4, 5, 6, "d", "e", "f", False),
    (7, 8, 9, "g", "h", "i", True)
)

# Checking Data Types
print(type(Nested_tuple_inList[0]))
print(type(Nested_tuple_inList[1]))
print(type(Nested_tuple_inList[2]))
```

